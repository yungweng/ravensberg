{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.1/.schema/devbox.schema.json",
  "packages": [
    "nodejs@26.8.1",
    "bun@1.3.13",
    "poppler-utils@26.06.0",
    "imagemagick@7.1.2-29"
  ],
  "shell": {
    "init_hook": [
      "echo 'devbox ready — node, bun, pdftoppm, magick'"
    ],
    "scripts": {
      "dev": ["bun run dev"],
      "build": ["bun run build"],
      "lint": ["bun run lint"],
      "lint:fix": ["bun run lint:fix"]
    }
  }
}
